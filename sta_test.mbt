///|
fn instance(
  name : String,
  cell : String,
  pins : Array[(String, String)],
) -> @sta.GateInstance {
  {
    name,
    cell: "sky130_fd_sc_hd__" + cell + "_1",
    connections: pins.map(p => { pin: p.0, net: p.1, }),
  }
}

///|
fn sequential() -> @sta.Netlist {
  {
    ports: [
      { name: "clk", net: "clk", direction: Input, },
      { name: "a", net: "a", direction: Input, },
      { name: "y", net: "y", direction: Output, },
    ],
    gates: [
      instance("launch", "dfxtp", [("CLK", "clk"), ("D", "a"), ("Q", "q")]),
      instance("i0", "inv", [("A", "q"), ("Y", "d")]),
      instance("capture", "dfxtp", [("CLK", "clk"), ("D", "d"), ("Q", "y")]),
    ],
    nets: ["clk", "a", "q", "d", "y"].map(n => {
      name: n,
      wire_cap_farads: 0.0,
    }),
  }
}

///|
fn sdc() -> String {
  let text =
    #|create_clock -name clk -period 2 [get_ports clk]
    #|set_clock_transition 0.1 [get_clocks clk]
    #|set_input_delay -clock clk -max 0.05 [get_ports a]
    #|set_input_transition 0.1 [get_ports a]
    #|set_output_delay -clock clk -max 0.1 [get_ports y]
    #|set_load 0.01 [get_ports y]
    #|set_clock_uncertainty -setup 0.02 [get_clocks clk]
  text
}

///|
fn near(x : Double, y : Double, tolerance? : Double = 1.0e-15) -> Unit raise {
  assert_true((x - y).abs() <= tolerance, msg="actual \{x}, expected \{y}")
}

///|
fn node(r : @sta.STAResult, pin : String, edge : @sta.Edge) -> @sta.NodeTiming {
  r.nodes.iter().find_first(n => n.pin == pin && n.edge == edge).unwrap()
}

///|
fn endpoint(
  r : @sta.STAResult,
  pin : String,
  edge : @sta.Edge,
) -> @sta.EndpointTiming {
  r.endpoints.iter().find_first(n => n.pin == pin && n.edge == edge).unwrap()
}

///|
fn run(
  n : @sta.Netlist,
  c : @sta.TimingConstraints,
  lib? : @liberty.Library = @liberty.load_library(@testdata.library()),
) -> @sta.STAResult raise {
  @sta.STAEngine::new(lib, n, c).run_setup_analysis()
}

///|
fn expect_error(
  n : @sta.Netlist,
  c : @sta.TimingConstraints,
  contains : String,
) -> Unit raise {
  try run(n, c) catch {
    e => assert_true("\{@debug.Debug::to_repr(e)}".contains(contains))
  } noraise {
    _ => fail("expected rejection: " + contains)
  }
}

///|
test "real Sky130 sequential path agrees with independently run OpenSTA baseline" {
  let lib = @liberty.load_library(@testdata.library())
  let n = sequential()
  let c = @sta.parse_sdc(sdc(), lib, n)
  let r = run(n, c, lib~)
  // External OpenSTA 2.0.17 reference, not generated by the MoonBit algorithm.
  near(node(r, "launch/Q", Rise).arrival_seconds.unwrap(), 0.317083388567e-9)
  near(node(r, "launch/Q", Fall).arrival_seconds.unwrap(), 0.308234572411e-9)
  near(node(r, "i0/Y", Rise).arrival_seconds.unwrap(), 0.341704279184e-9)
  near(node(r, "i0/Y", Fall).arrival_seconds.unwrap(), 0.345059722662e-9)
  near(node(r, "capture/Q", Rise).slew_seconds, 0.105476401746e-9)
  near(endpoint(r, "y", Rise).slack_seconds.unwrap(), 1.512276291847e-9)
  assert_true(r.topological_order == ["i0"])
  assert_true(endpoint(r, "capture/D", Rise).setup_seconds is Some(_))
}

///|
test "clock period latency uncertainty are separate from data delay" {
  let lib = @liberty.load_library(@testdata.library())
  let n = sequential()
  let c = @sta.parse_sdc(sdc(), lib, n)
  let before = run(n, c, lib~)
  let changed = {
    ..c,
    clock: {
      ..c.clock,
      period_seconds: c.clock.period_seconds + 0.5e-9,
      latency_seconds: 0.2e-9,
      uncertainty_seconds: c.clock.uncertainty_seconds + 0.1e-9,
    },
  }
  let after = run(n, changed, lib~)
  near(
    after.worst_slack_seconds.unwrap() - before.worst_slack_seconds.unwrap(),
    0.4e-9,
  )
  near(
    node(after, "launch/Q", Rise).arrival_seconds.unwrap() -
    node(before, "launch/Q", Rise).arrival_seconds.unwrap(),
    0.2e-9,
  )
  let tight = run(
    n,
    { ..c, clock: { ..c.clock, period_seconds: 0.2e-9, }, },
    lib~,
  )
  assert_true(tight.worst_slack_seconds.unwrap() < 0.0)
}

///|
test "rise/fall pin capacitance and external load aggregate in SI units" {
  let lib = @liberty.load_library(@testdata.library())
  let n = sequential()
  let c = @sta.parse_sdc(sdc(), lib, n)
  let r = run(n, c, lib~)
  near(node(r, "launch/Q", Rise).load_farads, 0.002390e-12, tolerance=1.0e-25)
  near(node(r, "launch/Q", Fall).load_farads, 0.002214e-12, tolerance=1.0e-25)
  near(node(r, "capture/Q", Rise).load_farads, 0.01e-12, tolerance=1.0e-25)
  let nets = n.nets.map(v => {
    if v.name == "q" {
      { ..v, wire_cap_farads: 0.004e-12, }
    } else {
      v
    }
  })
  let loaded = run({ ..n, nets, }, c, lib~)
  near(
    node(loaded, "launch/Q", Rise).load_farads,
    0.006390e-12,
    tolerance=1.0e-25,
  )
  assert_true(
    node(loaded, "launch/Q", Rise).arrival_seconds.unwrap() >
    node(r, "launch/Q", Rise).arrival_seconds.unwrap(),
  )
}

///|
test "inverter path preserves transition reversal and setup algebra" {
  let lib = @liberty.load_library(@testdata.library())
  let n = sequential()
  let c = @sta.parse_sdc(sdc(), lib, n)
  let r = run(n, c, lib~)
  let e = endpoint(r, "capture/D", Rise)
  assert_true(e.path[0].edge == Fall)
  // Recombining separately rounded fields can differ by one ULP in this
  // positive fixture. Exact constraint sums have independent rational tests.
  for
    (actual, regrouped) in [
      (
        e.slack_seconds.unwrap(),
        e.required_seconds.unwrap() - e.arrival_seconds.unwrap(),
      ),
      (
        e.required_seconds.unwrap(),
        c.clock.period_seconds -
        c.clock.uncertainty_seconds -
        e.setup_seconds.unwrap(),
      ),
    ] {
    let a = actual.reinterpret_as_uint64()
    let b = regrouped.reinterpret_as_uint64()
    assert_true(a + 1 >= b && b + 1 >= a)
  }
}

///|
test "missing I/O constraints remain unconstrained rather than successful zero slack" {
  let lib = @liberty.load_library(@testdata.library())
  let n = sequential()
  let c = @sta.parse_sdc(sdc(), lib, n)
  let r = run(n, { ..c, input_delays: [], output_delays: [], }, lib~)
  assert_true(endpoint(r, "launch/D", Rise).slack_seconds is None)
  assert_true(endpoint(r, "y", Rise).required_seconds is None)
}

///|
test "normal register feedback is cut but a real combinational loop is rejected" {
  let lib = @liberty.load_library(@testdata.library())
  let n = sequential()
  let c = @sta.parse_sdc(sdc(), lib, n)
  let gates = n.gates.copy()
  gates[0] = instance("launch", "dfxtp", [
    ("CLK", "clk"),
    ("D", "y"),
    ("Q", "q"),
  ])
  ignore(run({ ..n, gates, }, c, lib~))
  let gates = n.gates.copy()
  gates[1] = instance("i0", "inv", [("A", "d"), ("Y", "d")])
  expect_error({ ..n, gates, }, c, "CombinationalLoopDetected")
}

///|
test "structural errors reject missing nets pins duplicate names and multiple drivers" {
  let lib = @liberty.load_library(@testdata.library())
  let n = sequential()
  let c = @sta.parse_sdc(sdc(), lib, n)
  expect_error(
    { ..n, nets: n.nets.filter(x => x.name != "q"), },
    c,
    "UnresolvedNet",
  )
  expect_error({ ..n, nets: n.nets + [n.nets[0]], }, c, "duplicate")
  let gates = n.gates.copy()
  gates[1] = instance("i0", "inv", [("A", "q")])
  expect_error({ ..n, gates, }, c, "unconnected")
  let gates = n.gates + [instance("other", "inv", [("A", "a"), ("Y", "q")])]
  expect_error({ ..n, gates, }, c, "MultipleDrivers")
  expect_error({ ..n, gates: n.gates + [n.gates[0]], }, c, "duplicate")
}

///|
test "numeric bad loads and missing input slew are rejected" {
  let lib = @liberty.load_library(@testdata.library())
  let n = sequential()
  let c = @sta.parse_sdc(sdc(), lib, n)
  expect_error(
    { ..n, nets: n.nets.map(v => { ..v, wire_cap_farads: -1.0, }), },
    c,
    "nonnegative",
  )
  expect_error(n, { ..c, input_slews: [], }, "missing input transition")
  expect_error(
    n,
    { ..c, clock: { ..c.clock, period_seconds: 0.0, }, },
    "positive clock",
  )
}

///|
test "restricted SDC rejects scripting unknown commands flags clocks and objects" {
  let lib = @liberty.load_library(@testdata.library())
  let n = sequential()
  for
    extra in [
      "set foo 1", "create_clock -name other -period 1 [get_ports clk]", "set_input_delay -clock clk -min 0.1 [get_ports a]",
      "set_load 0.1 [get_ports missing]", "set_input_delay -clock wrong 0.1 [get_ports a]",
      "set_load $foo [get_ports y]", "set_load 0.1 [get_ports y",
    ] {
    try @sta.parse_sdc(sdc() + "\n" + extra, lib, n) catch {
      _ => ()
    } noraise {
      _ => fail("SDC should reject " + extra)
    }
  }
}

///|
test "SDC rise/fall overrides wildcard and explicit waveform" {
  let lib = @liberty.load_library(@testdata.library())
  let n = sequential()
  let c = @sta.parse_sdc(
    sdc() +
    "\nset_input_delay -rise -clock clk 0.2 [get_ports *]\nset_input_transition -fall 0.3 [get_ports a]",
    lib,
    n,
  )
  near(c.input_delays[0].rise.unwrap(), 0.2e-9)
  near(c.input_delays[0].fall.unwrap(), 0.05e-9)
  near(c.input_slews[0].fall.unwrap(), 0.3e-9)
  ignore(
    @sta.parse_sdc(
      "create_clock -name clk -period 2 -waveform {0 1} [get_ports clk]", lib, n,
    ),
  )
}

///|
test "JSON host boundary returns structured failures for malformed inputs" {
  for request in ["not json", "{}", "{\"netlist\":null}"] {
    let result = @json.parse(@sta.analyze_json(@testdata.library(), request))
    guard result is { "ok": False, .. } else { fail("expected JSON error") }
  }
}

///|
test "out-of-grid queries report extrapolation and clamp and reject explicitly" {
  let lib = @liberty.load_library(@testdata.library())
  let n = sequential()
  let original = @sta.parse_sdc(sdc(), lib, n)
  let c = {
    ..original,
    input_slews: [{ port: "a", rise: Some(2.0e-9), fall: Some(2.0e-9), }],
  }
  let extrapolated = @sta.STAEngine::new(lib, n, c).run_setup_analysis()
  assert_true(extrapolated.diagnostics.any(s => s.contains("extrapolated:")))
  let clamped = @sta.STAEngine::new(lib, n, c, policy=Clamp).run_setup_analysis()
  assert_true(clamped.diagnostics.any(s => s.contains("clamped:")))
  try @sta.STAEngine::new(lib, n, c, policy=Reject).run_setup_analysis() catch {
    _ => ()
  } noraise {
    _ => fail("Reject must reject out-of-grid setup table")
  }
}

///|
test "missing and conditional arcs are explicit errors rather than skipped paths" {
  let lib = @liberty.load_library(@testdata.library())
  let n = sequential()
  let c = @sta.parse_sdc(sdc(), lib, n)
  let missing = {
    ..lib,
    cells: lib.cells.map(cell => {
      if cell.name == "sky130_fd_sc_hd__inv_1" {
        {
          ..cell,
          pins: cell.pins.map(pin => {
            if pin.direction == Some("output") {
              { ..pin, timings: [], }
            } else {
              pin
            }
          }),
        }
      } else {
        cell
      }
    }),
  }
  try run(n, c, lib=missing) catch {
    _ => ()
  } noraise {
    _ => fail("missing output arcs must reject")
  }
  let conditional = {
    ..lib,
    cells: lib.cells.map(cell => {
      if cell.name == "sky130_fd_sc_hd__inv_1" {
        {
          ..cell,
          pins: cell.pins.map(pin => {
            ..pin,
            timings: pin.timings.map(a => { ..a, condition: Some("A"), }),
          }),
        }
      } else {
        cell
      }
    }),
  }
  try run(n, c, lib=conditional) catch {
    _ => ()
  } noraise {
    _ => fail("conditional arcs must not silently pass")
  }
}
