{
  "netlist": {
    "ports": [
      {
        "name": "clk",
        "net": "clk",
        "direction": "input"
      },
      {
        "name": "a",
        "net": "a",
        "direction": "input"
      },
      {
        "name": "y",
        "net": "y",
        "direction": "output"
      }
    ],
    "gates": [
      {
        "name": "b0",
        "cell": "sky130_fd_sc_hd__inv_1",
        "connections": [
          {
            "pin": "A",
            "net": "a"
          },
          {
            "pin": "Y",
            "net": "n0"
          }
        ]
      },
      {
        "name": "b1",
        "cell": "sky130_fd_sc_hd__inv_1",
        "connections": [
          {
            "pin": "A",
            "net": "n0"
          },
          {
            "pin": "Y",
            "net": "n1"
          }
        ]
      },
      {
        "name": "b2",
        "cell": "sky130_fd_sc_hd__inv_1",
        "connections": [
          {
            "pin": "A",
            "net": "n1"
          },
          {
            "pin": "Y",
            "net": "y"
          }
        ]
      }
    ],
    "nets": [
      {
        "name": "clk",
        "wire_cap_farads": 0
      },
      {
        "name": "a",
        "wire_cap_farads": 0
      },
      {
        "name": "y",
        "wire_cap_farads": 0.0
      },
      {
        "name": "n0",
        "wire_cap_farads": 0.0
      },
      {
        "name": "n1",
        "wire_cap_farads": 0.0
      }
    ]
  },
  "sdc": "create_clock -name clk -period 2 [get_ports clk]\nset_clock_transition 0.1 [get_clocks clk]\nset_clock_uncertainty -setup 0.02 [get_clocks clk]\nset_input_delay -clock clk -max 0.0300 [get_ports a]\nset_input_transition 0.0800 [get_ports a]\nset_output_delay -clock clk -max 0.1 [get_ports y]\nset_load 0.01 [get_ports y]\n"
}