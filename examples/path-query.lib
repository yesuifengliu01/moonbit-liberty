library (path_query_demo) {
  delay_model : table_lookup;
  time_unit : "1ns";
  capacitive_load_unit (1, "pf");
  voltage_unit : "1V";
  slew_derate_from_library : 1;
  lu_table_template (axis) { variable_1 : input_net_transition; index_1 ("0, 1"); }
  lu_table_template (setup_axis) { variable_1 : constrained_pin_transition; index_1 ("0, 1"); }
  lu_table_template (surface) {
    variable_1 : input_net_transition; variable_2 : total_output_net_capacitance;
    index_1 ("0, 1"); index_2 ("0, 4");
  }
cell (MERGE2) {
    pin (A) { direction : input; capacitance : 0; }
    pin (B) { direction : input; capacitance : 0; }
    pin (Y) { direction : output; function : "A | B";
timing () {
      related_pin : "A"; timing_sense : positive_unate; timing_type : combinational;
      cell_rise (axis) { values ("0.2, 0.2"); }
      cell_fall (axis) { values ("0.2, 0.2"); }
      rise_transition (axis) { values ("0.1, 0.1"); }
      fall_transition (axis) { values ("0.1, 0.1"); }
    }
timing () {
      related_pin : "B"; timing_sense : positive_unate; timing_type : combinational;
      cell_rise (axis) { values ("0.4, 0.4"); }
      cell_fall (axis) { values ("0.4, 0.4"); }
      rise_transition (axis) { values ("0.1, 0.1"); }
      fall_transition (axis) { values ("0.1, 0.1"); }
    }
} }
cell (BUF) {
    pin (A) { direction : input; capacitance : 0; }
    pin (Y) { direction : output; function : "A";
      timing () {
      related_pin : "A"; timing_sense : positive_unate; timing_type : combinational;
      cell_rise (axis) { values ("0.3, 0.3"); }
      cell_fall (axis) { values ("0.3, 0.3"); }
      rise_transition (axis) { values ("0.1, 0.1"); }
      fall_transition (axis) { values ("0.1, 0.1"); }
    }
    }
  }
cell (INV) {
    pin (A) { direction : input; capacitance : 0; }
    pin (Y) { direction : output; function : "!A";
      timing () {
      related_pin : "A"; timing_sense : negative_unate; timing_type : combinational;
      cell_rise (axis) { values ("0.3, 0.3"); }
      cell_fall (axis) { values ("0.3, 0.3"); }
      rise_transition (axis) { values ("0.1, 0.1"); }
      fall_transition (axis) { values ("0.1, 0.1"); }
    }
    }
  }
cell (PBUF) {
    pin (A) { direction : input; capacitance : 0; }
    pin (Y) { direction : output; function : "A";
      timing () {
      related_pin : "A"; timing_sense : positive_unate; timing_type : combinational;
      cell_rise (axis) { values ("0.2, 0.2"); }
      cell_fall (axis) { values ("0.2, 0.2"); }
      rise_transition (axis) { values ("0.1, 0.1"); }
      fall_transition (axis) { values ("0.1, 0.1"); }
    }
    }
  }
cell (QBUF) {
    pin (A) { direction : input; capacitance : 0; }
    pin (Y) { direction : output; function : "A";
      timing () {
      related_pin : "A"; timing_sense : positive_unate; timing_type : combinational;
      cell_rise (axis) { values ("0.4, 0.4"); }
      cell_fall (axis) { values ("0.4, 0.4"); }
      rise_transition (axis) { values ("0.1, 0.1"); }
      fall_transition (axis) { values ("0.1, 0.1"); }
    }
    }
  }
cell (NU) {
    pin (A) { direction : input; capacitance : 0; }
    pin (B) { direction : input; capacitance : 0; }
    pin (Y) { direction : output; function : "A ^ B";
timing () {
      related_pin : "A"; timing_sense : non_unate; timing_type : combinational;
      cell_rise (axis) { values ("0.2, 0.2"); }
      cell_fall (axis) { values ("0.2, 0.2"); }
      rise_transition (axis) { values ("0.1, 0.1"); }
      fall_transition (axis) { values ("0.1, 0.1"); }
    }
timing () {
      related_pin : "B"; timing_sense : non_unate; timing_type : combinational;
      cell_rise (axis) { values ("0.4, 0.4"); }
      cell_fall (axis) { values ("0.4, 0.4"); }
      rise_transition (axis) { values ("0.1, 0.1"); }
      fall_transition (axis) { values ("0.1, 0.1"); }
    }
} }
cell (DUAL) {
    pin (A) { direction : input; capacitance : 0; }
    pin (B) { direction : input; capacitance : 0; }
    pin (Y) { direction : output; function : "A";
timing () {
      related_pin : "A"; timing_sense : positive_unate; timing_type : combinational;
      cell_rise (axis) { values ("0.2, 0.2"); }
      cell_fall (axis) { values ("0.2, 0.2"); }
      rise_transition (axis) { values ("0.1, 0.1"); }
      fall_transition (axis) { values ("0.1, 0.1"); }
    } }
    pin (Z) { direction : output; function : "B";
timing () {
      related_pin : "B"; timing_sense : positive_unate; timing_type : combinational;
      cell_rise (axis) { values ("0.3, 0.3"); }
      cell_fall (axis) { values ("0.3, 0.3"); }
      rise_transition (axis) { values ("0.1, 0.1"); }
      fall_transition (axis) { values ("0.1, 0.1"); }
    }
} }
cell (DFF) {
    ff (IQ, IQ_N) { clocked_on : "CLK"; next_state : "D"; }
    pin (CLK) { direction : input; clock : true; capacitance : 0; }
    pin (D) { direction : input; capacitance : 0;
      timing () { related_pin : "CLK"; timing_type : setup_rising;
        rise_constraint (setup_axis) { values ("0.15, 0.15"); }
        fall_constraint (setup_axis) { values ("0.15, 0.15"); }
      }
    }
    pin (Q) { direction : output; function : "IQ";
timing () {
      related_pin : "CLK"; timing_sense : non_unate; timing_type : rising_edge;
      cell_rise (axis) { values ("0.25, 0.25"); }
      cell_fall (axis) { values ("0.25, 0.25"); }
      rise_transition (axis) { values ("0.1, 0.1"); }
      fall_transition (axis) { values ("0.1, 0.1"); }
    }
} }
}
