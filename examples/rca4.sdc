create_clock -name clk -period 2.0 [get_ports clk]
set_clock_transition 0.1 [get_clocks clk]
set_clock_uncertainty -setup 0.02 [get_clocks clk]
set_input_delay -clock clk -max 0.0300 [get_ports a0]
set_input_transition 0.0800 [get_ports a0]
set_input_delay -clock clk -max 0.0400 [get_ports a1]
set_input_transition 0.0900 [get_ports a1]
set_input_delay -clock clk -max 0.0500 [get_ports a2]
set_input_transition 0.1000 [get_ports a2]
set_input_delay -clock clk -max 0.0600 [get_ports a3]
set_input_transition 0.1100 [get_ports a3]
set_input_delay -clock clk -max 0.0700 [get_ports b0]
set_input_transition 0.1200 [get_ports b0]
set_input_delay -clock clk -max 0.0800 [get_ports b1]
set_input_transition 0.1300 [get_ports b1]
set_input_delay -clock clk -max 0.0900 [get_ports b2]
set_input_transition 0.1400 [get_ports b2]
set_input_delay -clock clk -max 0.1000 [get_ports b3]
set_input_transition 0.1500 [get_ports b3]
set_input_delay -clock clk -max 0.1100 [get_ports cin]
set_input_transition 0.1600 [get_ports cin]
set_output_delay -clock clk -max 0.1 [get_ports s0]
set_load 0.01 [get_ports s0]
set_output_delay -clock clk -max 0.1 [get_ports s1]
set_load 0.01 [get_ports s1]
set_output_delay -clock clk -max 0.1 [get_ports s2]
set_load 0.01 [get_ports s2]
set_output_delay -clock clk -max 0.1 [get_ports s3]
set_load 0.01 [get_ports s3]
set_output_delay -clock clk -max 0.1 [get_ports cout]
set_load 0.01 [get_ports cout]
