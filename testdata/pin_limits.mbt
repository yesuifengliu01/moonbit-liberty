///|
/// Frozen independent pin-limit facts; real slew comes from accepted old GBA.
pub fn pin_limit_cases() -> String {
  let text =
    #|{
    #|  "basis": "Synthetic rows use complete hand facts and SI conversion before implementation; real case uses accepted old GBA measurements and hand declared limits, frozen separately before product edits. No new timing/checker algorithm is used.",
    #|  "tolerance": {
    #|    "relative": 1e-14,
    #|    "seconds_absolute": 1e-21,
    #|    "farads_absolute": 1e-27
    #|  },
    #|  "existingSky130Path": "examples/sky130-demo.lib",
    #|  "libraries": {
    #|    "strict": "library (pin_limit_demo) {\n      delay_model : table_lookup; time_unit : \"1ns\";\n      capacitive_load_unit (1, \"pf\"); voltage_unit : \"1V\";\n      default_max_transition : 0.4; slew_derate_from_library : 1;\n      lu_table_template (surface) { variable_1 : input_net_transition; variable_2 : total_output_net_capacitance;\n        index_1 (\"0, 1\"); index_2 (\"0, 2\"); }\n      lu_table_template (setup_axis) { variable_1 : constrained_pin_transition; index_1 (\"0, 1\"); }\n      cell (DRV) {\n        pin (A) { direction : input; capacitance : 0; max_transition : 0.15; }\n        pin (Y) { direction : output; function : \"A\"; max_capacitance : 1; max_transition : 0.25;\n          timing () { related_pin : \"A\"; timing_type : combinational; timing_sense : positive_unate;\n          cell_rise (surface) { values (\"0.1, 0.1\", \"0.1, 0.1\"); }\n          cell_fall (surface) { values (\"0.1, 0.1\", \"0.1, 0.1\"); }\n          rise_transition (surface) { values (\"0.2, 0.2\", \"0.2, 0.2\"); }\n          fall_transition (surface) { values (\"0.3, 0.3\", \"0.3, 0.3\"); }\n        } }\n      }\n      cell (RCV) {\n        pin (A) { direction : input; capacitance : 0.25;\n          rise_capacitance : 0.25; fall_capacitance : 0.5; max_transition : 0.22; }\n        pin (Y) { direction : output; function : \"A\"; max_capacitance : 0.5;\n          timing () { related_pin : \"A\"; timing_type : combinational; timing_sense : positive_unate;\n          cell_rise (surface) { values (\"0.1, 0.1\", \"0.1, 0.1\"); }\n          cell_fall (surface) { values (\"0.1, 0.1\", \"0.1, 0.1\"); }\n          rise_transition (surface) { values (\"0.1, 0.1\", \"0.1, 0.1\"); }\n          fall_transition (surface) { values (\"0.1, 0.1\", \"0.1, 0.1\"); }\n        } }\n      }\n      cell (DFF) { ff (IQ,IQ_N) { clocked_on : \"CLK\"; next_state : \"D\"; }\n        pin (CLK) { direction : input; clock : true; capacitance : 0; }\n        pin (D) { direction : input; capacitance : 0; max_transition : 0.15;\n          timing () { related_pin : \"CLK\"; timing_type : setup_rising;\n            rise_constraint (setup_axis) { values (\"0.15, 0.15\"); }\n            fall_constraint (setup_axis) { values (\"0.15, 0.15\"); } } }\n        pin (Q) { direction : output; function : \"IQ\"; max_capacitance : 0.5; max_transition : 0.25;\n          timing () { related_pin : \"CLK\"; timing_type : rising_edge; timing_sense : non_unate;\n          cell_rise (surface) { values (\"0.1, 0.1\", \"0.1, 0.1\"); }\n          cell_fall (surface) { values (\"0.1, 0.1\", \"0.1, 0.1\"); }\n          rise_transition (surface) { values (\"0.2, 0.2\", \"0.2, 0.2\"); }\n          fall_transition (surface) { values (\"0.3, 0.3\", \"0.3, 0.3\"); }\n        } }\n      }\n    }\n",
    #|    "met": "library (pin_limit_demo) {\n      delay_model : table_lookup; time_unit : \"1ns\";\n      capacitive_load_unit (1, \"pf\"); voltage_unit : \"1V\";\n      default_max_transition : 0.4; slew_derate_from_library : 1;\n      lu_table_template (surface) { variable_1 : input_net_transition; variable_2 : total_output_net_capacitance;\n        index_1 (\"0, 1\"); index_2 (\"0, 2\"); }\n      lu_table_template (setup_axis) { variable_1 : constrained_pin_transition; index_1 (\"0, 1\"); }\n      cell (DRV) {\n        pin (A) { direction : input; capacitance : 0; max_transition : 0.25; }\n        pin (Y) { direction : output; function : \"A\"; max_capacitance : 1.5; max_transition : 0.35;\n          timing () { related_pin : \"A\"; timing_type : combinational; timing_sense : positive_unate;\n          cell_rise (surface) { values (\"0.1, 0.1\", \"0.1, 0.1\"); }\n          cell_fall (surface) { values (\"0.1, 0.1\", \"0.1, 0.1\"); }\n          rise_transition (surface) { values (\"0.2, 0.2\", \"0.2, 0.2\"); }\n          fall_transition (surface) { values (\"0.3, 0.3\", \"0.3, 0.3\"); }\n        } }\n      }\n      cell (RCV) {\n        pin (A) { direction : input; capacitance : 0.25;\n          rise_capacitance : 0.25; fall_capacitance : 0.5; max_transition : 0.35; }\n        pin (Y) { direction : output; function : \"A\"; max_capacitance : 0.5;\n          timing () { related_pin : \"A\"; timing_type : combinational; timing_sense : positive_unate;\n          cell_rise (surface) { values (\"0.1, 0.1\", \"0.1, 0.1\"); }\n          cell_fall (surface) { values (\"0.1, 0.1\", \"0.1, 0.1\"); }\n          rise_transition (surface) { values (\"0.1, 0.1\", \"0.1, 0.1\"); }\n          fall_transition (surface) { values (\"0.1, 0.1\", \"0.1, 0.1\"); }\n        } }\n      }\n      cell (DFF) { ff (IQ,IQ_N) { clocked_on : \"CLK\"; next_state : \"D\"; }\n        pin (CLK) { direction : input; clock : true; capacitance : 0; }\n        pin (D) { direction : input; capacitance